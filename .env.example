APP_NAME="Audit Master"
APP_ENV=local
APP_KEY=
# En production : APP_DEBUG=false, sans quoi une simple erreur expose la
# trace complète et le mot de passe de la base.
APP_DEBUG=true
APP_URL=http://audit-master.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL requis : le schéma utilise ILIKE et to_char().
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=audit
DB_USERNAME=postgres
DB_PASSWORD=

# Compte administrateur initial, créé par `php artisan db:seed`.
# Le mot de passe n'est plus écrit en dur dans le code.
ADMIN_NAME="Expert N'jie ZAMON"
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` écrit les e-mails dans storage/logs au lieu de les envoyer :
# pratique en développement, à remplacer en production.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="audit@njiezm.fr"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
